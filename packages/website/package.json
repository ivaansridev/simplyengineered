{
  "name": "@simplyengineered/website",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter simplyengineered build && vite dev",
    "build": "pnpm --filter simplyengineered build && vite build",
    "preview": "vite preview",
    "check": "pnpm --filter simplyengineered build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "pnpm --filter simplyengineered build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@replit/codemirror-lang-svelte": "^6.0.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "codemirror": "^6.0.2",
    "simplyengineered": "workspace:*",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
